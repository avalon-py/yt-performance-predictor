# Copy this file to .env and fill in real values.
# .env is gitignored -- .env.example is the committed template, so anyone
# cloning the repo knows what variables are needed without guessing.

# Postgres
POSTGRES_USER=ytpp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ytpp

# MinIO (S3-compatible object storage, local dev stand-in for Oracle Object Storage)
MINIO_ROOT_USER=ytpp
MINIO_ROOT_PASSWORD=ytpp_2026_proj
MINIO_ENDPOINT=localhost:9000

# Training purposes
YOUTUBE_API_KEY=GetMeFromGoogleConsole
TUBECENSUS_DIR=your/path/to/tubecensus_data

# Airflow Identities
AIRFLOW_JWT_SECRET=base64:whateveryourpasswordisrandomly
HOST_PROJECT_DIR=your/path/to/your/repo/root